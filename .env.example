NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=devices
DB_USERNAME=root
DB_PASSWORD=123456
DB_CONNECTION_LIMIT=10
NETWORK_MONITOR_DB_HOST=localhost
NETWORK_MONITOR_DB_PORT=3306
NETWORK_MONITOR_DB_NAME=network_monitor
NETWORK_MONITOR_DB_USERNAME=root
NETWORK_MONITOR_DB_PASSWORD=123456
NETWORK_MONITOR_DB_CONNECTION_LIMIT=5

# Add matching entries to config/database.yaml for each additional database.
# AUDIT_DB_HOST=localhost
# AUDIT_DB_PORT=3306
# AUDIT_DB_NAME=audit
# AUDIT_DB_USERNAME=root
# AUDIT_DB_PASSWORD=
# AUDIT_DB_CONNECTION_LIMIT=5

# Test uses a separate database to prevent changing development data.
TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_NAME=devices_test
TEST_DB_USERNAME=root
TEST_DB_PASSWORD=123456
TEST_DB_CONNECTION_LIMIT=5
TEST_NETWORK_MONITOR_DB_HOST=localhost
TEST_NETWORK_MONITOR_DB_PORT=3306
TEST_NETWORK_MONITOR_DB_NAME=network_monitor_test
TEST_NETWORK_MONITOR_DB_USERNAME=root
TEST_NETWORK_MONITOR_DB_PASSWORD=123456
TEST_NETWORK_MONITOR_DB_CONNECTION_LIMIT=5

# Set these through the production secret manager; do not commit real values.
# PROD_DB_HOST=
# PROD_DB_PORT=3306
# PROD_DB_NAME=
# PROD_DB_USERNAME=
# PROD_DB_PASSWORD=
# PROD_DB_CONNECTION_LIMIT=20
# PROD_NETWORK_MONITOR_DB_HOST=
# PROD_NETWORK_MONITOR_DB_PORT=3306
# PROD_NETWORK_MONITOR_DB_NAME=network_monitor
# PROD_NETWORK_MONITOR_DB_USERNAME=
# PROD_NETWORK_MONITOR_DB_PASSWORD=
# PROD_NETWORK_MONITOR_DB_CONNECTION_LIMIT=10
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=2h
